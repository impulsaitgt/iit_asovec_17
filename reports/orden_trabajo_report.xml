<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_report_orden_trabajo" model="ir.actions.report">
    <field name="name">Orden de Trabajo</field>
    <field name="model">asovec.orden_trabajo</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">iit_asovec.report_orden_trabajo</field>
    <field name="report_file">iit_asovec.report_orden_trabajo</field>
    <field name="print_report_name">'Orden de Trabajo - %s' % (object.name)</field>
  </record>

  <!-- NOTA: en este entorno wkhtmltopdf, el texto con tildes/ñ dentro de celdas de
       &lt;table&gt;/&lt;td&gt; se corrompe (aparece "Ã³" en vez de "ó"); el mismo texto
       en &lt;div&gt;/&lt;span&gt; renderiza bien. Por eso este reporte evita &lt;table&gt;
       para el contenido con texto (solo se usa una tabla para las líneas de firma, que
       no llevan texto con tildes). -->
  <template id="report_orden_trabajo">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-set="logo" t-value="logos.get(o.company_id.id)" />
        <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
        <div class="page">

          <table style="width:100%; margin-bottom:14px; border-collapse:collapse;">
            <tr>
              <td style="width:1%; white-space:nowrap; vertical-align:middle; padding:0;">
                <img t-if="logo" t-att-src="image_data_uri(logo)" style="max-height: 70px;" alt="Logo" />
              </td>
              <td style="vertical-align:middle; text-align:center; font-size:20px; padding:0;">
                ORDEN DE TRABAJO
              </td>
              <td style="width:1%;"></td>
            </tr>
          </table>

          <div style="margin-bottom:12px;">
            <div>Fecha emisión: <span t-esc="o.fecha_creacion" t-options="{'widget': 'date'}" /></div>
            <div>Correlativo: <span t-esc="o.name" /></div>
          </div>

          <t t-set="filas" t-value="[
            ('Proyecto', o.proyecto_aso_id.name or ''),
            ('Residencia', o.residencia_id.name or ''),
            ('Propietario', o.cliente_id.name or ''),
            ('Dirección', o.direccion or ''),
            ('Teléfono', o.telefono or ''),
            ('Colaborador creador de la orden', o.creador_id.name or ''),
            ('Colaborador', o.colaborador_id.name or ''),
          ]" />

          <div style="border:1px solid #999; border-top:none;">
            <t t-foreach="filas" t-as="fila">
              <div style="border-top:1px solid #999; overflow:hidden;">
                <div style="width:35%; float:left; background-color:#eeeeee; padding:5px 8px; box-sizing:border-box;">
                  <span t-esc="fila[0]" />
                </div>
                <div style="margin-left:35%; padding:5px 8px;">
                  <span t-esc="fila[1]" />
                </div>
              </div>
            </t>
            <div style="border-top:1px solid #999; overflow:hidden;">
              <div style="width:35%; float:left; background-color:#eeeeee; padding:5px 8px; box-sizing:border-box;">
                Fecha finalización
              </div>
              <div style="margin-left:35%; padding:5px 8px;">
                <span t-if="o.fecha_finalizacion" t-esc="o.fecha_finalizacion" t-options="{'widget': 'date'}" />
              </div>
            </div>
            <div style="border-top:1px solid #999; background-color:#eeeeee; padding:5px 8px;">Concepto</div>
            <div style="border-top:1px solid #999; padding:6px 8px; white-space:pre-line; min-height:40px;">
              <span t-esc="o.concepto or ''" />
            </div>
            <div style="border-top:1px solid #999; background-color:#eeeeee; padding:5px 8px;">Reporte</div>
            <div style="border-top:1px solid #999; padding:6px 8px; white-space:pre-line; min-height:40px;">
              <span t-esc="o.reporte or ''" />
            </div>
          </div>

          <table style="width:100%; margin-top:60px;">
            <tr style="text-align:center;">
              <td style="width:33%; border-top:1px solid #333; padding-top:4px;">ASOGUA</td>
              <td style="width:33%; border-top:1px solid #333; padding-top:4px;">VECINO</td>
              <td style="width:33%; border-top:1px solid #333; padding-top:4px;">FIRMA COLABORADOR</td>
            </tr>
          </table>

        </div>
        </div>
      </t>
    </t>
  </template>

</odoo>
