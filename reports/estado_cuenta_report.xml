<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Acción del reporte -->
    <record id="action_report_estado_cuenta_pdf" model="ir.actions.report">
      <field name="name">Estado de Cuenta</field>
      <field name="model">asovec.cobro_mensual_consulta_wizard</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">iit_asovec.estado_cuenta_pdf</field>
      <field name="report_file">iit_asovec.estado_cuenta_pdf</field>
      <field name="print_report_name">'Estado de Cuenta - %s' % (object.cliente_id.display_name or object.residencia_ids[:1].display_name)</field>
    </record>

    <!-- Template QWeb: usa el mismo `_build_estado_cuenta_data` que el reporte HTML y el
         Excel (ver report.iit_asovec.estado_cuenta_pdf / report_estado_cuenta_document en
         models/estado_cuenta_report.py), para que los tres siempre coincidan. -->
    <template id="estado_cuenta_pdf">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">

          <div class="page">
            <h2 style="margin-bottom: 4px;">Estado de Cuenta</h2>

            <div style="margin-bottom: 8px;">
              <strong>Proyecto:</strong> <span t-esc="proyecto.display_name"/><br/>
              <strong>Residencia(s):</strong> <span t-esc="', '.join(residencias.mapped('display_name'))"/><br/>
              <strong>Dirección(es):</strong> <span t-esc="direcciones"/><br/>
              <strong t-if="cliente">Residente:</strong> <span t-if="cliente" t-esc="cliente.name"/>
              <t t-if="cliente"><br/></t>
              <strong t-if="periodo_activo">Período:</strong> <span t-if="periodo_activo" t-esc="periodo_label"/>
              <t t-if="periodo_activo"><br/></t>
              <strong>Generado:</strong> <span t-esc="generated_at"/>
            </div>

            <div style="margin-bottom: 14px; padding: 8px 12px; background: #fff8e1; border-left: 3px solid #b8860b; font-size: 11px;">
              <t t-if="periodo_activo">
                Se muestran los movimientos (cargos y pagos aplicados) del período indicado arriba,
                con Saldo Inicial y Saldo Final.
              </t>
              <t t-if="not periodo_activo">
                Se muestran todos los movimientos (cargos y pagos aplicados) con saldo acumulado,
                hasta la fecha y hora de generación indicada arriba; movimientos posteriores no
                están reflejados.
              </t>
              <t t-if="solo_residente_actual"> Se muestran únicamente los movimientos del residente actual.</t>
              <t t-if="excluir_cargos_mes_actual"> No se incluyen cargos con detalle de cobro del mes en curso.</t>
              <t t-if="resumen['cantidad_sin_aplicar']"> <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#c62828;"></span> Pago no conciliado a ningún cargo (crédito a favor).</t>
            </div>

            <!-- Moneda base -->
            <t t-set="cur_symbol" t-value="currency and currency.symbol or ''"/>

            <table class="table table-sm o_main_table" style="width:100%; border-collapse: collapse;">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th t-if="len(residencias) &gt; 1">Residencia</th>
                  <th>Tipo</th>
                  <th>Cargo/Pago</th>
                  <th>Diario</th>
                  <th t-if="tiene_convenio">Convenio</th>
                  <th>Referencia Cliente</th>
                  <th class="text-end">Debe</th>
                  <th class="text-end">Haber</th>
                  <th class="text-end">Saldo</th>
                </tr>
              </thead>
              <tbody>
                <tr t-if="periodo_activo">
                  <td t-attf-colspan="#{5 + (len(residencias) &gt; 1 and 1 or 0) + (tiene_convenio and 1 or 0)}"><strong>Saldo Inicial</strong></td>
                  <td class="text-end"></td>
                  <td class="text-end"></td>
                  <td class="text-end">
                    <strong t-esc="('%s %s' % (cur_symbol, '{:,.2f}'.format(saldo_inicial or 0.0))).strip()"/>
                  </td>
                </tr>
                <t t-foreach="movimientos" t-as="m">
                  <t t-set="msym" t-value="(m['currency'] and m['currency'].symbol) or cur_symbol"/>
                  <tr>
                    <td><span t-esc="m['date'] and m['date'].strftime('%d/%m/%Y') or ''"/></td>
                    <td t-if="len(residencias) &gt; 1"><span t-esc="m['residencia'].name"/></td>
                    <td><span t-esc="m['tipo_label']"/></td>
                    <td>
                      <span t-esc="m['move_name'] or m['pago_ref'] or ''"/>
                      <span t-if="m['tipo'] == 'Pago' and not m['aplicado']"
                        style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#c62828; margin-left:5px;"></span>
                    </td>
                    <td><span t-esc="m['journal'].name if m['journal'] else ''"/></td>
                    <td t-if="tiene_convenio"><span t-esc="m['convenio'].numero if m['convenio'] else ''"/></td>
                    <td><span t-esc="m['referencia_cliente'] or ''"/></td>
                    <td class="text-end">
                      <span t-esc="m['debe'] and ('%s %s' % (msym, '{:,.2f}'.format(m['debe']))).strip() or ''"/>
                    </td>
                    <td class="text-end">
                      <span t-esc="m['haber'] and ('%s %s' % (msym, '{:,.2f}'.format(m['haber']))).strip() or ''"/>
                    </td>
                    <td class="text-end">
                      <span t-esc="('%s %s' % (msym, '{:,.2f}'.format(m['saldo_acumulado']))).strip()"/>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>

            <!-- Totales -->
            <div style="margin-top: 14px; width: 40%; margin-left: auto;">
              <table class="table table-sm" style="width:100%;">
                <tr t-if="periodo_activo">
                  <td><strong>Saldo Inicial</strong></td>
                  <td class="text-end">
                    <strong t-esc="('%s %s' % (cur_symbol, '{:,.2f}'.format(saldo_inicial or 0.0))).strip()"/>
                  </td>
                </tr>
                <tr>
                  <td><strong t-esc="'Cargos del período' if periodo_activo else 'Total cargos'"/></td>
                  <td class="text-end">
                    <strong t-esc="('%s %s' % (cur_symbol, '{:,.2f}'.format(resumen['total_facturado'] or 0.0))).strip()"/>
                  </td>
                </tr>
                <tr>
                  <td><strong t-esc="'Pagos del período' if periodo_activo else 'Total pagado'"/></td>
                  <td class="text-end">
                    <strong t-esc="('%s %s' % (cur_symbol, '{:,.2f}'.format(resumen['total_pagado'] or 0.0))).strip()"/>
                  </td>
                </tr>
                <tr>
                  <td><strong t-esc="'Saldo Final' if periodo_activo else 'Saldo total'"/></td>
                  <td class="text-end">
                    <strong t-esc="('%s %s' % (cur_symbol, '{:,.2f}'.format(resumen['total_saldo'] or 0.0))).strip()"/>
                  </td>
                </tr>
              </table>
            </div>

            <t t-foreach="historial_lecturas" t-as="bloque">
              <h3 style="margin-top: 20px; margin-bottom: 6px; font-size: 13px;">
                Historial de Lecturas
                <t t-if="len(residencias) &gt; 1"> — <span t-esc="bloque['residencia'].display_name"/></t>
                <t t-if="lecturas_periodo_activo"> — Período <span t-esc="periodo_label"/></t>
              </h3>
              <table class="table table-sm o_main_table" style="width:100%; border-collapse: collapse;">
                <thead>
                  <tr>
                    <th>Período</th>
                    <th class="text-end">Lectura</th>
                    <th class="text-end">Lectura anterior</th>
                    <th class="text-end">Consumo</th>
                    <th class="text-end">Canon de agua</th>
                    <th class="text-end">Exceso (pago extra)</th>
                    <th class="text-end">Total</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-foreach="bloque['lineas']" t-as="ln">
                    <t t-set="lsym" t-value="(ln.currency_id and ln.currency_id.symbol) or cur_symbol"/>
                    <tr>
                      <td>
                        <t t-if="ln.es_inicial">Registro Inicial</t>
                        <t t-else="">
                          <span t-esc="dict(ln._fields['mes'].selection).get(ln.mes, ln.mes)"/> <span t-esc="ln.anio"/>
                        </t>
                      </td>
                      <td class="text-end"><span t-esc="'{:,.2f}'.format(ln.lectura or 0.0)"/></td>
                      <td class="text-end"><span t-esc="'{:,.2f}'.format(ln.lectura_anterior or 0.0)"/></td>
                      <td class="text-end"><span t-esc="'{:,.2f}'.format(ln.consumo or 0.0)"/></td>
                      <td class="text-end"><span t-esc="('%s %s' % (lsym, '{:,.2f}'.format(ln.base or 0.0))).strip()"/></td>
                      <td class="text-end"><span t-esc="('%s %s' % (lsym, '{:,.2f}'.format(ln.pago_extra or 0.0))).strip()"/></td>
                      <td class="text-end"><strong t-esc="('%s %s' % (lsym, '{:,.2f}'.format(ln.pago_total or 0.0))).strip()"/></td>
                    </tr>
                  </t>
                  <t t-if="not bloque['lineas']">
                    <tr><td colspan="7" style="text-align:center;">Sin lecturas registradas.</td></tr>
                  </t>
                </tbody>
              </table>
            </t>

          </div>

        </t>
        </t>
      </t>
    </template>

  </data>
</odoo>
