<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asovec_cambio_contador_wizard_form" model="ir.ui.view">
        <field name="name">asovec.cambio_contador_wizard.form</field>
        <field name="model">asovec.cambio_contador_wizard</field>
        <field name="arch" type="xml">
            <form string="Cambio de Contador">
                <field name="tiene_contador_actual" invisible="1" />

                <sheet>
                    <group>
                        <field name="residencia_id" options="{'no_create': True}" />
                    </group>

                    <div class="alert alert-info" role="alert"
                        invisible="not residencia_id or tiene_contador_actual">
                        Esta residencia no tiene un contador activo actualmente: se creará
                        el primero, con la lectura inicial que indique abajo.
                    </div>

                    <group invisible="not residencia_id" string="Datos de la residencia">
                        <group>
                            <field name="cliente_id" readonly="1" />
                            <field name="proyecto_aso_id" readonly="1" />
                        </group>
                        <group>
                            <field name="direccion_real" readonly="1" />
                        </group>
                    </group>

                    <group invisible="not tiene_contador_actual" string="Contador actual (se desactivará)">
                        <group>
                            <field name="contador_actual_id" readonly="1" force_save="1" />
                            <field name="ultima_lectura" readonly="1" />
                        </group>
                        <group>
                            <field name="ultima_fecha" readonly="1" />
                            <field name="ultimo_consumo" readonly="1" />
                        </group>
                    </group>

                    <group invisible="not residencia_id" string="Contador nuevo">
                        <field name="contador_nuevo_nombre" placeholder="Ej. 12345" />
                        <field name="lectura_inicial" />
                    </group>
                </sheet>

                <footer>
                    <button name="action_confirmar"
                        string="Confirmar Cambio de Contador"
                        type="object"
                        class="btn-primary"
                        invisible="not residencia_id" />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="cambio_contador_wizard_action" model="ir.actions.act_window">
        <field name="name">Cambio de Contador</field>
        <field name="res_model">asovec.cambio_contador_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
