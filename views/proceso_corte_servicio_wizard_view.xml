<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_asovec_proceso_corte_servicio_wizard_form" model="ir.ui.view">
      <field name="name">asovec.proceso_corte_servicio_wizard.form</field>
      <field name="model">asovec.proceso_corte_servicio_wizard</field>
      <field name="arch" type="xml">
        <form string="Notificación de Corte de Servicio">
          <sheet>
            <group>
              <group>
                <field name="proyecto_aso_id" options="{'no_create': True}" />
                <field name="mes" />
                <field name="anio" />
                <field name="meses_atraso" />
              </group>
              <group>
                <field name="fecha_impresion" />
                <field name="dias_habiles_corte" />
                <field name="fecha_corte" readonly="1" />
                <field name="line_count" readonly="1" />
              </group>
            </group>

            <field name="line_ids" invisible="not line_ids">
              <tree create="0" delete="0" default_order="proyecto_aso_id, residencia_id">
                <field name="seleccionado" widget="boolean_toggle" />
                <field name="proyecto_aso_id" />
                <field name="residencia_id" string="Lote" />
                <field name="cliente_id" string="Propietario" />
                <field name="direccion_real" />
                <field name="meses_atraso" />
                <field name="meses_detalle" />
                <field name="monto_atraso" />
              </tree>
            </field>

            <div invisible="not line_ids" class="mt-2">
              <button name="action_marcar_todos" type="object" string="Marcar todos" class="btn-link" />
              <button name="action_desmarcar_todos" type="object" string="Desmarcar todos" class="btn-link" />
            </div>

            <group invisible="not file_data">
              <field name="file_name" invisible="1" />
              <field name="file_data" filename="file_name" widget="binary" readonly="1" string="Archivo Excel generado" />
            </group>

            <footer>
              <button name="action_buscar" type="object" string="Buscar" class="btn-primary" />
              <button name="action_generar_excel" type="object" string="Generar Excel" class="btn-secondary" />
              <button name="action_generar_pdf" type="object" string="Generar PDF" class="btn-secondary" />
              <button string="Cerrar" special="cancel" class="btn-secondary" />
            </footer>
          </sheet>
        </form>
      </field>
    </record>

  </data>
</odoo>
